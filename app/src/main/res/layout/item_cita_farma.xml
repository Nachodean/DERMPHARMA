<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tv_item_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="#202124"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_item_franja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mañana"
            android:textColor="#5F6368"
            android:textSize="12sp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_item_nombre_paciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Paciente"
                android:textColor="#202124"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_item_motivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motivo de la consulta"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_item_ver_ficha"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="VER FICHA DE PACIENTE"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:focusable="false"
                android:clickable="false"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>